{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "ignoreDeprecations": "5.0",
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "react": [
        "../../node_modules/.bun/react@18.3.1/node_modules/react"
      ],
      "react/jsx-runtime": [
        "../../node_modules/.bun/react@18.3.1/node_modules/react/jsx-runtime"
      ],
      "react/jsx-dev-runtime": [
        "../../node_modules/.bun/react@18.3.1/node_modules/react/jsx-dev-runtime"
      ],
      "react-dom": [
        "../../node_modules/.bun/react-dom@18.3.1+f4eacebf2041cd4f/node_modules/react-dom"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "target": "ES2020",
    "types": [
      "vite/client",
      "react",
      "react-dom",
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ]
}
